{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yi68-classroom",
  "main": "worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    "LOCAL_AUTH_ONLY": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yi68-classroom",
      "migrations_dir": "drizzle"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
